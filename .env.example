# Supabase bağlantı bilgileri.
# Supabase panelinde: Project Settings > API bölümünden alın.
# Bu değerleri kopyalayıp .env.local dosyasına yapıştırın (o dosya git'e girmez).

NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_PUBLIC_KEY

# Supabase → Authentication → URL Configuration → Redirect URLs listesine ekleyin:
# http://127.0.0.1:3000/**
# http://127.0.0.1:3000/auth/callback
# http://127.0.0.1:3000/sifre-yenile
NEXT_PUBLIC_SITE_URL=http://127.0.0.1:3000
