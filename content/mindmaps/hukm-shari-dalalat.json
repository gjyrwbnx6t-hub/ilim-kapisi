                          { "id": "w1-def-iqtida-fil-request", "titleAr": "يشمل: طلب الفعل على وجه الإلزام (الوجوب) أو الترجيح (الندب)", "children": [] },
                          { "id": "w1-def-iqtida-kaff-request", "titleAr": "يشمل: طلب الكف على وجه الإلزام (التحريم) أو الترجيح (الكراهة)", "children": [] }
